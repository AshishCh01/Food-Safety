# Application
APP_NAME=Food Safety Platform API
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase PostgreSQL connection string
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/postgres

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# JWT authentication
# Generate a strong random value for local/production use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage (used for complaint/inspection evidence uploads)
# Use the service-role key on the backend only - never ship it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-evidence

# Separate private Supabase Storage bucket for RAG source documents
# (docs/RAG_ARCHITECTURE.md) - distinct from the evidence bucket above.
RAG_STORAGE_BUCKET=rag-documents


GEMINI_API_KEY=

GEMINI_MAIN_MODEL=gemini-3.7-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_REQUEST_TIMEOUT_SECONDS=20

# Output dimensionality requested from GEMINI_EMBEDDING_MODEL. Must match the
# fixed size of the `rag_document_chunks.embedding` pgvector column
# (EMBEDDING_DIM=768 in alembic/versions/7c3f1a9d2e4b_add_rag_and_assistant_tables.py) -
# if you change GEMINI_EMBEDDING_MODEL to one with a different native
# dimensionality, either leave this at 768 (Gemini embedding models support
# configurable output dimensionality) or write a new migration to resize the
# column (and re-embed existing chunks) before changing this value.
GEMINI_EMBEDDING_DIMENSIONS=768

# Groq fallback (complaint triage / investigation / inspector assistant only
# - see app/services/ai_service.py generate_structured_json_groq). Used when
# Gemini is rate-limited or unavailable. Leave GROQ_API_KEY empty to disable
# the fallback entirely (those agents will just fail as before on a Gemini
# outage).
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_REQUEST_TIMEOUT_SECONDS=30

# Reverse geocoding (best-effort address lookup for a picked map location)
# via OpenStreetMap's Nominatim service. Set a real contact address in the
# user agent per Nominatim's usage policy if you increase request volume.
ENABLE_REVERSE_GEOCODING=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=food-safety-platform/1.0 (contact: ops@foodsafety.local)
